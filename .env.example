# =============================================================================
# Campus Fix It — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (Neon, Supabase, or local Docker)
DATABASE_URL=

# PostgreSQL connection string for the TEST database (used by Vitest API tests)
DATABASE_URL_TEST=

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID — https://portal.azure.com/
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Set to your institution's tenant ID, or "common" for multi-tenant (dev only)
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# Campus email domain restriction (e.g. college.edu). Only emails ending in
# @<ALLOWED_EMAIL_DOMAIN> may sign in.
ALLOWED_EMAIL_DOMAIN=college.edu

# --- Object Storage (Cloudflare R2 or AWS S3 — S3-compatible API) ---
# Endpoint URL: for R2 use https://<accountId>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# AWS region (use "auto" for Cloudflare R2)
STORAGE_REGION=auto

# --- Email (Resend) ---
RESEND_API_KEY=
# "From" address e.g. no-reply@college.edu
EMAIL_FROM=

# --- Cron jobs ---
# Secret header value for /api/cron/* endpoints. Generate: openssl rand -hex 32
CRON_SECRET=

# --- App ---
# Full URL including protocol, no trailing slash
APP_URL=http://localhost:3000

# --- Seed ---
# Email of the initial super admin user (must match ALLOWED_EMAIL_DOMAIN)
SEED_SUPER_ADMIN_EMAIL=

# --- Error tracking (Sentry) ---
# Leave blank to disable Sentry (Phase 1 default)
SENTRY_DSN=

# --- Test auth bypass ---
# Set to "true" ONLY in test environments. Must NEVER be true in production.
AUTH_TEST_MODE=false
